<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the saved sign-in session out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pepsi_auth_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pepsi_auth_session.xml"/>
    </device-transfer>
</data-extraction-rules>
